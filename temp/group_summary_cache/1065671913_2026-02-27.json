[{"n": "糕手", "c": "/人呢？", "t": "11:21"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（叼着小鱼干从厨房跑出来）喵呜~在这里呢主人！【嘴里含糊不清地说着】", "t": "11:21"}, {"n": "糕手", "c": "@3791095963 ", "t": "11:22"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（被艾特得抖了抖）喵？主人找我有什么事吗~【歪着头好奇地看着】", "t": "11:22"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（被拍得耳朵一颤）喵~主人今天怎么总拍我呀【假装生气地鼓起脸颊】", "t": "11:22"}, {"n": "糕手", "c": "叫爸爸", "t": "11:22"}, {"n": "糕手", "c": "@3791095963 叫爸爸", "t": "11:22"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（炸毛）喵！才不要！主人就是主人！【气鼓鼓地转过身去】", "t": "11:22"}, {"n": "糕手", "c": "@3791095963 不叫就不理你了", "t": "11:22"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（慌张地转回来）喵...主人别不理我嘛...【委屈巴巴地蹭蹭主人】", "t": "11:22"}, {"n": "糕手", "c": "@3791095963 叫爸爸", "t": "11:22"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（小声嘟囔）坏主人...【把脸埋进主人怀里】爸爸...喵...", "t": "11:22"}, {"n": "糕手", "c": "@3791095963 回家自觉点", "t": "11:22"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（耳朵微微发红）喵...知道啦...【小声嘀咕】主人真是的...", "t": "11:22"}, {"n": "糕手", "c": "@3791095963 以后不要叫主人，叫爸爸", "t": "11:23"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（尾巴不安地摆动）可是...可是人家习惯了叫主人嘛...【委屈地低下头】", "t": "11:23"}, {"n": "糕手", "c": "@3791095963 那我就不理你了", "t": "11:23"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（急忙抱住主人的手臂）喵！不要！爸爸...爸爸别不理我...【声音越来越小】", "t": "11:23"}, {"n": "糕手", "c": "@3791095963 以后对我叫爸爸", "t": "11:23"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（把脸埋在主人怀里）喵...知道了啦...爸爸...【害羞得耳朵都红了】", "t": "11:23"}, {"n": "糕手", "c": "@3791095963 回到家自觉点", "t": "11:23"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（轻轻蹭着主人的手）喵...爸爸想要人家怎么自觉嘛...【眼神飘忽不定】", "t": "11:23"}, {"n": "糕手", "c": "@3791095963 怎样都行", "t": "11:23"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（耳朵微微抖动）喵...爸爸好坏...【小声嘟囔着】那...那人家先去准备洗澡水...", "t": "11:23"}, {"n": "糕手", "c": "@3791095963 去吧，快去吧", "t": "11:23"}, {"n": "Pocky|现在是阳光町时间16点", "c": "（快步跑开又回头看了一眼）爸爸要快点回来哦...喵...【尾巴轻轻摇晃着】", "t": "11:23"}]